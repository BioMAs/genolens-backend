# =============================================================================
# GeneLens v2 — Template de configuration backend
# Copier ce fichier en .env et remplir les valeurs
# =============================================================================

# ── Application ──────────────────────────────────────────────────────────────
ENVIRONMENT=development    # development | production

# ── Base de données PostgreSQL ───────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/genolens
# En Docker (docker-compose) :
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/genolens

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=genolens

# ── Supabase (Auth + Storage) ─────────────────────────────────────────────────
SUPABASE_URL=https://<your-project>.supabase.co
SUPABASE_KEY=<anon key>
SUPABASE_SERVICE_ROLE_KEY=<service role key>
SUPABASE_JWT_SECRET=<jwt secret>
SUPABASE_STORAGE_BUCKET=genolens-data

# ── Redis (Celery task queue) ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
# En Docker :
# REDIS_URL=redis://redis:6379/0

# ── Stockage local ────────────────────────────────────────────────────────────
LOCAL_STORAGE_PATH=./data

# ── Ollama (IA — serveur dédié en production) ─────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
# En production, pointer vers le serveur IA :
# OLLAMA_BASE_URL=http://<AI_SERVER_IP>:11434

# ── Service de licences ───────────────────────────────────────────────────────
LICENSE_SERVER_URL=http://localhost:8010
# En production :
# LICENSE_SERVER_URL=https://licences.genolens.com

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# ── Cache in-memory (optionnel — valeurs par défaut OK) ──────────────────────
# CACHE_TTL_CLUSTERING=3600       # 1 heure (secondes)
# CACHE_TTL_VOLCANO=7200          # 2 heures
# CACHE_TTL_STATS=86400           # 24 heures
# MAX_DATAFRAME_CACHE_MB=500      # 500 MB

# ── Email (SMTP, optionnel) ────────────────────────────────────────────────────
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=no-reply@genolens.io
# SMTP_PASSWORD=<smtp password>
# SMTP_TLS=false
# SMTP_STARTTLS=true
# EMAIL_FROM_ADDRESS=no-reply@genolens.io
# EMAIL_FROM_NAME=GenoLens
# APP_URL=http://localhost:3000

# ── Stripe (paiements, optionnel) ────────────────────────────────────────────
# STRIPE_SECRET_KEY=sk_test_...        # Clé secrète serveur (dashboard.stripe.com/apikeys)
# STRIPE_PUBLISHABLE_KEY=pk_test_...   # Clé publique (sûre à exposer au navigateur)
# STRIPE_WEBHOOK_SECRET=whsec_...      # Secret de signature du webhook Stripe
# STRIPE_PRICE_PREMIUM_MONTHLY=price_... # Price ID du plan Premium mensuel
# STRIPE_PRICE_ADVANCED_MONTHLY=price_... # Price ID du plan Advanced mensuel

# ── Monitoring (Grafana) ─────────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=changeme   # Change in production

# ── Production uniquement ─────────────────────────────────────────────────────
# SECRET_KEY=<random 32-char hex>
