# GenoLens backend: environment template.
#
#   cp .env.example .env
#
# Every value below is a placeholder, never a real secret. The .env is never committed (.gitignore) and
# never baked into an image (.dockerignore). Production passes its configuration through the host's .env
# read by docker-compose.prod.yml. The settings are documented in app/core/config.py; the authentication
# ones in docs/AUTH.md.

# ── Application ─────────────────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
# DEBUG only turns the SQL echo on (every statement in the logs): false in production.
DEBUG=true
# Public URL of the frontend (used in the links of e-mails).
APP_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ── Database and queue ──────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/genolens
REDIS_URL=redis://localhost:6379/0

# ── Authentication: which provider is in charge (docs/AUTH.md) ──────────────────────────────────
# supabase: the hosted provider authenticates requests (default; today's behaviour).
# local:    this service authenticates (its own accounts, passwords and second factor).
AUTH_MODE=supabase
# true: serve the local sign-in endpoints and accept local tokens WHATEVER AUTH_MODE says (the
# migration window, when both providers answer). false: the local endpoints answer 404.
AUTH_LOCAL_ENABLED=false
# `iss` of the access tokens this service issues, and the host of its API. https://... in production.
AUTH_ISSUER=http://localhost:8001
# ES256 signing keys: base64 of a PKCS#8 PEM (P-256), comma-separated; the first signs, all verify.
# Generate with: python -m app.auth.cli generate-keys   (required once the local authentication is on)
AUTH_JWT_PRIVATE_KEYS=
# Fernet keys that encrypt the second-factor secrets at rest, comma-separated; the first encrypts, all
# decrypt. Generated by the same command. Losing it makes every enrolled second factor unreadable.
AUTH_ENCRYPTION_KEYS=
# Domain shared by the cookies of the API and of the web apps (e.g. .example.test); empty: the API host only.
AUTH_COOKIE_DOMAIN=
# Send the refresh cookie over HTTPS only. Turn off for plain-HTTP local development only.
AUTH_COOKIE_SECURE=true

# ── Hosted provider (Supabase): required only when AUTH_MODE=supabase ───────────────────────────
# In that mode the service refuses to start without the first three. In AUTH_MODE=local they can be left out.
SUPABASE_URL=https://your-project.supabase.example.test
SUPABASE_KEY=your-anon-key
SUPABASE_JWT_SECRET=your-jwt-secret
# Admin operations of the hosted provider (falls back to SUPABASE_KEY when empty).
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=genolens-data
# Connection string of the hosted database, for the one-off account migration script ONLY
# (python -m app.auth.migrate_from_supabase). It holds a password: do not keep it in a service's
# environment, pass it to that one command (see docs/AUTH.md).
# SUPABASE_DB_URL=

# ── Licence ─────────────────────────────────────────────────────────────────────────────────────
GENOLENS_LICENSE_KEY=
LICENSE_SECRET_KEY=
LICENSE_PRODUCT=genolens

# ── Deployment tool (admin) ─────────────────────────────────────────────────────────────────────
# Fernet key that encrypts the SSH keys and the deployment secrets at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DEPLOYMENT_ENCRYPTION_KEY=

# ── LLM inference (OpenAI-compatible endpoint) ──────────────────────────────────────────────────
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=not-needed
LLM_MODEL=google/gemma-4-E4B-it

# ── Drug discovery service (genolens-dd); empty key disables the integration ────────────────────
DD_BASE_URL=https://dd.genolens.com
DD_API_KEY=
DD_TIMEOUT_SECONDS=30

# ── E-mail (SMTP). Required by the local authentication: its security e-mails must leave ───────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=false
SMTP_STARTTLS=true
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=GenoLens
SALES_EMAIL=contact@scilicium.com
# The address the security e-mails (password changed, 2FA on or reset, recovery code used) tell the
# reader to contact. Set it to a real, monitored mailbox before opening the local authentication.
SUPPORT_EMAIL=support@scilicium.com

# ── Billing (Stripe) ────────────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_TEAM_MONTHLY=
STRIPE_PRICE_TEAM_ANNUAL=

# ── Files ───────────────────────────────────────────────────────────────────────────────────────
LOCAL_STORAGE_PATH=/app/data
